# ===================================================================
# ARA-1 Environment Variables
# ===================================================================
# Copy this file to .env and fill in your keys.
# Only GROQ_API_KEY is strictly required to run the agent.
# ===================================================================

# --- Groq LLM API (REQUIRED) ---
# Get your key at: https://console.groq.com
GROQ_API_KEY=gsk_your_groq_api_key_here

# --- Groq Model IDs ---
# Planning / synthesis / final report generation (large reasoning model)
GROQ_PLANNING_MODEL=openai/gpt-oss-120b
# Cheap/fast sub-tasks (query classification, disambiguation, tool selection)
GROQ_FAST_MODEL=openai/gpt-oss-20b
# Evaluation LLM-as-judge (must differ from the planning model)
GROQ_JUDGE_MODEL=qwen/qwen3.6-27b

# --- Groq Rate Limits ---
# Adjust these based on your Groq tier (free vs paid)
GROQ_REQUESTS_PER_MINUTE=30
GROQ_TOKENS_PER_MINUTE=14400

# --- SEC EDGAR ---
# No API key needed. SEC requires a descriptive User-Agent header instead.
# Format: "CompanyName AdminEmail" (e.g., "QuantumEdge Research admin@quantumedge.com")
SEC_EDGAR_USER_AGENT=QuantumEdge Research atif.khan@example.com

# --- Financial Data API ---
# Financial Modeling Prep: https://financialmodelingprep.com/developer
FMP_API_KEY=your_fmp_api_key_here
# Alpha Vantage (fallback): https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here

# --- Web Search ---
# Tavily: https://tavily.com (free tier available)
TAVILY_API_KEY=your_tavily_api_key_here

# --- News Sentiment ---
# NewsAPI.org: https://newsapi.org/register (free tier: 100 req/day)
NEWS_API_KEY=your_newsapi_key_here

# --- Vector DB ---
# Local Chroma is the default (no key needed).
# For production migration to Pinecone/Qdrant, add keys here.
CHROMA_PERSIST_DIR=./data/chroma_db

# --- Embeddings ---
# Default: sentence-transformers/all-MiniLM-L6-v2 (local, free, CPU-only)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Logging ---
LOG_LEVEL=INFO
LOG_FILE=./logs/ara1.jsonl
